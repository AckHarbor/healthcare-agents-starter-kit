# AckHarbor™ starter kit settings. Copy to .env (never commit .env) or export these in your shell.
# Synthetic data only. Never put real patient data (PHI) anywhere in this kit.
AH_FHIR_BASE=http://127.0.0.1:8090/fhir
AH_MLLP_PORT=2575
AH_VIEW_PORT=8091
AH_AGENT_LOG=/tmp/ackharbor-agent-log.jsonl
AH_ENGINE_LOG=/tmp/ackharbor-engine-acks.jsonl
# Optional AI step (off by default). Set AH_AI=1 and your OWN free-tier key, synthetic data only.
AH_AI=
AH_AI_MODEL=
AH_GEMINI_API_KEY=
# Path to HAPI FHIR main.war if you don't use Docker
HAPI_WAR=
